# seltool-go 容器配置模板
#
# 复制为 .env 后填值。只放容器启动需要的参数；
# CookieCloud / 通知 / MoviePilot / 定时任务 这些在 Web 面板里设置，
# 会存到 config/*.json，不需要写在这里。
#
# 改完执行：docker compose up -d --force-recreate

# ---- 镜像（可选）----
# 不写就用 compose 里的默认值（ghcr 最新版）。
# 要锁版本或回滚时再取消注释：
# IMAGE=ghcr.io/a454735639-lab/seltool-go:sha-abc1234

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 端口映射（宿主机端口）----
# 不要命名为 VNC_PORT / HTTP_PORT：容器内 entrypoint 用这两个名字
# 控制 x11vnc 和 web 监听，注入进去会把内部端口改乱。
HOST_HTTP_PORT=8081
HOST_VNC_PORT=7900

# ---- VNC 密码（必改）----
SE_VNC_PASSWORD=change-me

# ---- noVNC 允许的 Host（反代 / 跨机访问时用，逗号分隔）----
VNCPROXY_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- 代理排除（Docker daemon 会注入 HTTP_PROXY）----
NO_PROXY=localhost,127.0.0.1,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# ---- 浏览器出口代理（可选）----
# 留空 = 全站直连。填了以后所有目标都走这个代理，只有 targets.json 里
# 标了 noProxy 的站点仍走直连（用于被代理出口 IP 拦截的站）。
# 典型用法：某些 PT 站在 NAS 线路上被 reset（如 pt.gtkpw.xyz），
# 而本机代理能通，就把本机代理填这里。
# SELTOOL_PROXY=http://192.168.3.20:7890

# ---- CookieCloud 每日同步时间（唯一没有面板入口的项）----
SELTOOL_COOKIECLOUD_SYNC_CRON=0 0 4 * * *
