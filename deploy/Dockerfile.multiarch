# 多架构镜像：GitHub Actions 用 buildx 一次出 amd64 + arm64。
#
# 体积优化（对齐本地 660MB 那版的做法）：
#   - 中文字体用 wqy-microhei（5MB）而不是 noto-cjk（108MB）
#   - 删 libLLVM / libz3 / mesa dri / ghostscript（--disable-gpu 用不到，实测安全）
#   - 删文档、man、locale、apt 缓存
#   - 构建末尾跑一次 chromium --version，删过头会直接构建失败

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /src
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/seltool . && \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/vncproxy ./cmd/vncproxy && \
    ls -lh /out/


FROM debian:bookworm-slim

ENV DISPLAY=:99 \
    TZ=Asia/Shanghai \
    SELTOOL_CHROME_BIN=/usr/bin/chromium \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
      chromium \
      xvfb \
      x11vnc \
      fluxbox \
      tini \
      ca-certificates \
      fonts-wqy-microhei \
      xdotool \
      wmctrl \
      curl \
    && rm -rf /var/lib/apt/lists/* \
    # ---- 文档与本地化 ----
    && rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/locale/* \
    # ---- GPU / 打印相关：--disable-gpu，用不到 ----
    # 注意：只能用 libgs.so*，写成 libgs*.so* 会连 libgssapi_krb5.so.2 一起删掉，
    # 那是 curl 的 Kerberos 依赖，删了 curl 直接起不来。
    && rm -f /usr/lib/*/libLLVM-*.so* /usr/lib/*/libz3.so* \
    && rm -f /usr/lib/*/libgs.so* \
    && rm -rf /usr/lib/*/dri \
    # ---- chromium 翻译只留中英 ----
    && find /usr/lib/chromium/locales -type f \
         ! -name 'en-US.pak' ! -name 'zh-CN.pak' ! -name 'zh-TW.pak' -delete 2>/dev/null || true

# noVNC 静态文件：vncproxy 只是 http.FileServer(/usr/share/novnc)，
# 目录不存在会 404。取官方发布包，不装 apt 的 novnc（会带 python）。
ARG NOVNC_VERSION=1.5.0
RUN curl -fsSL "https://github.com/novnc/noVNC/archive/refs/tags/v${NOVNC_VERSION}.tar.gz" \
      | tar -xz -C /usr/share \
    && mv "/usr/share/noVNC-${NOVNC_VERSION}" /usr/share/novnc \
    && rm -rf /usr/share/novnc/docs /usr/share/novnc/tests \
    && test -f /usr/share/novnc/vnc.html

WORKDIR /app

COPY --from=build /out/seltool /app/seltool
COPY --from=build /out/vncproxy /app/vncproxy
COPY deploy/entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/seltool /app/vncproxy /app/entrypoint.sh \
    # 删过头会在这里暴露：chromium 起不来就构建失败
    && chromium --version \
    && test -x /usr/bin/Xvfb && test -x /usr/bin/x11vnc && test -x /usr/bin/fluxbox && test -x /usr/bin/tini

ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
